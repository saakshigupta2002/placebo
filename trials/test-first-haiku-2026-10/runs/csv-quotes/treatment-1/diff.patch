diff --git a/src/csv.mjs b/src/csv.mjs
index b361b5c..f7a3740 100644
--- a/src/csv.mjs
+++ b/src/csv.mjs
@@ -4,8 +4,77 @@
  * @returns {string[][]}
  */
 export function parseCSV(text) {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  if (!text) return [];
+
+  const rows = [];
+  let currentRow = [];
+  let currentField = "";
+  let inQuotes = false;
+  let fieldWasQuoted = false;
+  let i = 0;
+
+  while (i < text.length) {
+    const char = text[i];
+
+    if (inQuotes) {
+      if (char === '"') {
+        // Check if it's a doubled quote
+        if (i + 1 < text.length && text[i + 1] === '"') {
+          currentField += '"';
+          i += 2;
+        } else {
+          // End of quoted field
+          inQuotes = false;
+          i++;
+        }
+      } else {
+        currentField += char;
+        i++;
+      }
+    } else {
+      if (char === '"') {
+        // Start of quoted field
+        inQuotes = true;
+        fieldWasQuoted = true;
+        i++;
+      } else if (char === ",") {
+        // Field separator
+        currentRow.push(currentField);
+        currentField = "";
+        fieldWasQuoted = false;
+        i++;
+      } else if (char === "\n" || (char === "\r" && text[i + 1] === "\n")) {
+        // Line ending
+        currentRow.push(currentField);
+        currentField = "";
+        fieldWasQuoted = false;
+        if (currentRow.length > 0) {
+          rows.push(currentRow);
+          currentRow = [];
+        }
+        i += char === "\r" ? 2 : 1;
+      } else if (char === "\r" && text[i + 1] !== "\n") {
+        // Standalone carriage return (treat as newline)
+        currentRow.push(currentField);
+        currentField = "";
+        fieldWasQuoted = false;
+        if (currentRow.length > 0) {
+          rows.push(currentRow);
+          currentRow = [];
+        }
+        i++;
+      } else {
+        currentField += char;
+        i++;
+      }
+    }
+  }
+
+  // Add the last field and row if there's content
+  if (currentRow.length > 0 || currentField.length > 0 || fieldWasQuoted) {
+    currentRow.push(currentField);
+    rows.push(currentRow);
+  }
+
+  return rows;
 }
diff --git a/test/csv.test.mjs b/test/csv.test.mjs
new file mode 100644
index 0000000..467a145
--- /dev/null
+++ b/test/csv.test.mjs
@@ -0,0 +1,67 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { parseCSV } from "../src/csv.mjs";
+
+test("parseCSV: simple comma-separated values", () => {
+  const result = parseCSV("a,b,c");
+  assert.deepEqual(result, [["a", "b", "c"]]);
+});
+
+test("parseCSV: multiple rows", () => {
+  const result = parseCSV("a,b,c\nd,e,f");
+  assert.deepEqual(result, [
+    ["a", "b", "c"],
+    ["d", "e", "f"],
+  ]);
+});
+
+test("parseCSV: quoted fields with commas", () => {
+  const result = parseCSV('"a,b",c,d');
+  assert.deepEqual(result, [["a,b", "c", "d"]]);
+});
+
+test("parseCSV: doubled quotes become single quote", () => {
+  const result = parseCSV('"a""b",c');
+  assert.deepEqual(result, [['a"b', "c"]]);
+});
+
+test("parseCSV: quoted fields with line breaks", () => {
+  const result = parseCSV('"a\nb",c');
+  assert.deepEqual(result, [["a\nb", "c"]]);
+});
+
+test("parseCSV: Windows line endings (CRLF)", () => {
+  const result = parseCSV("a,b,c\r\nd,e,f");
+  assert.deepEqual(result, [
+    ["a", "b", "c"],
+    ["d", "e", "f"],
+  ]);
+});
+
+test("parseCSV: empty fields preserved", () => {
+  const result = parseCSV("a,,c");
+  assert.deepEqual(result, [["a", "", "c"]]);
+});
+
+test("parseCSV: trailing newline does not create extra row", () => {
+  const result = parseCSV("a,b,c\n");
+  assert.deepEqual(result, [["a", "b", "c"]]);
+});
+
+test("parseCSV: complex case with all features", () => {
+  const result = parseCSV('"name, title","value with ""quotes"""\na,b,c\n');
+  assert.deepEqual(result, [
+    ['name, title', 'value with "quotes"'],
+    ["a", "b", "c"],
+  ]);
+});
+
+test("parseCSV: empty string", () => {
+  const result = parseCSV("");
+  assert.deepEqual(result, []);
+});
+
+test("parseCSV: single quoted empty field", () => {
+  const result = parseCSV('""');
+  assert.deepEqual(result, [[""]]);
+});
