@@ -6,7 +7,26 @@ const SYMBOLS = { USD: "$", EUR: "€", GBP: "£", JPY: "¥" };
  * @param {string} currency
  */
 export function formatMoney(cents, currency = "USD") {
+  if (!Number.isInteger(cents)) {
+    throw new TypeError("cents must be an integer");
+  }
+
+  const isNegative = cents < 0;
+  const absCents = Math.abs(cents);
   const symbol = SYMBOLS[currency] ?? `${currency} `;
-  const amount = (cents / 100).toFixed(2);
-  return symbol + amount;
+
+  let formatted;
+  if (ZERO_DECIMAL_CURRENCIES.has(currency)) {
+    // For zero-decimal currencies, cents are actually whole units
+    const amount = absCents.toLocaleString();
+    formatted = symbol + amount;
+  } else {
+    // For standard currencies, convert cents to dollars and format
+    const dollars = Math.floor(absCents / 100);
+    const remainingCents = absCents % 100;
+    const amount = dollars.toLocaleString() + "." + String(remainingCents).padStart(2, "0");
+    formatted = symbol + amount;
+  }
+
+  return isNegative ? "-" + formatted : formatted;
 }
