 /**
  * Format integer cents as money, e.g. 123456 -> "$1,234.56".
@@ -6,7 +7,27 @@ const SYMBOLS = { USD: "$", EUR: "€", GBP: "£", JPY: "¥" };
  * @param {string} currency
  */
 export function formatMoney(cents, currency = "USD") {
+  if (!Number.isInteger(cents)) {
+    throw new TypeError("cents must be an integer");
+  }
+
+  const isNegative = cents < 0;
+  const absCents = Math.abs(cents);
   const symbol = SYMBOLS[currency] ?? `${currency} `;
-  const amount = (cents / 100).toFixed(2);
-  return symbol + amount;
+
+  let amount;
+  if (NO_MINOR_UNIT.has(currency)) {
+    // For currencies with no minor unit, amount is already in whole units
+    amount = absCents.toLocaleString("en-US");
+  } else {
+    // Convert cents to dollars/euros/etc and format with thousands separators
+    const dollars = absCents / 100;
+    amount = dollars.toLocaleString("en-US", {
+      minimumFractionDigits: 2,
+      maximumFractionDigits: 2,
+    });
+  }
+
+  const formatted = symbol + amount;
+  return isNegative ? "-" + formatted : formatted;
 }
