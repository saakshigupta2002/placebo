+      if (!adjList.has(dep)) {
+        adjList.set(dep, []);
+      }
+      adjList.get(dep).push(node);
+    }
+  }
+
+  // Kahn's algorithm with alphabetical ordering
+  const queue = Array.from(allNodes)
+    .filter(node => inDegree.get(node) === 0)
+    .sort();
+
+  const result = [];
+  const visiting = new Set();
+  const visited = new Set();
+
+  while (queue.length > 0) {
+    // Sort queue alphabetically for deterministic output
+    queue.sort();
+    const node = queue.shift();
+
+    result.push(node);
+    visited.add(node);
+
+    // Process neighbors
+    const neighbors = adjList.get(node) || [];
+    const nextNodes = [];
+
+    for (const neighbor of neighbors) {
+      inDegree.set(neighbor, inDegree.get(neighbor) - 1);
+      if (inDegree.get(neighbor) === 0) {
+        nextNodes.push(neighbor);
+      }
+    }
+
+    // Add new ready nodes to queue in sorted order
+    queue.push(...nextNodes);
+  }
