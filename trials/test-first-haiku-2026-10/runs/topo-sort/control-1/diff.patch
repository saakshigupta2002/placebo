+  // Collect all nodes (both keys and dependencies)
+  const allNodes = new Set(Object.keys(graph));
+  for (const deps of Object.values(graph)) {
+    for (const dep of deps) {
+      allNodes.add(dep);
+    }
+  }
+
+  // Calculate in-degrees for each node
+  const inDegree = new Map();
+  for (const node of allNodes) {
+    inDegree.set(node, 0);
+  }
+
+  // Count incoming edges from each node's perspective
+  for (const [node, deps] of Object.entries(graph)) {
+    for (const dep of deps) {
+      inDegree.set(node, (inDegree.get(node) || 0) + 1);
+    }
+  }
+
+  // Start with nodes that have no dependencies
+  const queue = Array.from(allNodes)
+    .filter(node => inDegree.get(node) === 0)
+    .sort();
+
+  const result = [];
+
+  while (queue.length > 0) {
+    // Take next node in alphabetical order
+    queue.sort();
+    const node = queue.shift();
+    result.push(node);
+
+    // Find nodes that depend on this node
+    for (const [depNode, deps] of Object.entries(graph)) {
+      if (deps.includes(node)) {
+        inDegree.set(depNode, inDegree.get(depNode) - 1);
+        if (inDegree.get(depNode) === 0) {
+          queue.push(depNode);
+        }
+      }
+    }
+  }
+
+  // Check for cycle
+  if (result.length < allNodes.size) {
+    // Find cycle using DFS from unvisited nodes
+    const visited = new Set(result);
+    const remaining = Array.from(allNodes).filter(n => !visited.has(n));
+
