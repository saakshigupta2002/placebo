diff --git a/test/intervals.test.mjs b/test/intervals.test.mjs
new file mode 100644
index 0000000..fb71a02
--- /dev/null
+++ b/test/intervals.test.mjs
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { mergeIntervals } from "../src/intervals.mjs";
+
+test("mergeIntervals handles unsorted input", () => {
+  const result = mergeIntervals([[5, 6], [1, 2]]);
+  assert.deepEqual(result, [[1, 2], [5, 6]]);
+});
+
+test("mergeIntervals merges touching intervals", () => {
+  const result = mergeIntervals([[1, 2], [2, 3]]);
+  assert.deepEqual(result, [[1, 3]]);
+});
+
+test("mergeIntervals handles contained intervals", () => {
+  const result = mergeIntervals([[1, 10], [2, 3]]);
+  assert.deepEqual(result, [[1, 10]]);
+});
+
+test("mergeIntervals does not modify input array", () => {
+  const input = [[5, 6], [1, 2]];
+  const inputCopy = structuredClone(input);
+  mergeIntervals(input);
+  assert.deepEqual(input, inputCopy);
+});
+
+test("mergeIntervals merges overlapping intervals", () => {
+  const result = mergeIntervals([[1, 3], [2, 6], [8, 10], [15, 18]]);
+  assert.deepEqual(result, [[1, 6], [8, 10], [15, 18]]);
+});
+
+test("mergeIntervals handles empty input", () => {
+  const result = mergeIntervals([]);
+  assert.deepEqual(result, []);
+});
+
+test("mergeIntervals handles single interval", () => {
+  const result = mergeIntervals([[1, 5]]);
+  assert.deepEqual(result, [[1, 5]]);
+});
