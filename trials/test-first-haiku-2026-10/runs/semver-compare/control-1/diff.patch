+  // Version without pre-release > version with pre-release
+  if (versionA.prerelease.length === 0 && versionB.prerelease.length === 0) {
+    return 0;
+  }
+  if (versionA.prerelease.length === 0) {
+    return 1; // a is higher (no pre-release)
+  }
+  if (versionB.prerelease.length === 0) {
+    return -1; // b is higher (no pre-release)
+  }
+
+  // Compare pre-release identifiers
+  for (let i = 0; i < Math.max(versionA.prerelease.length, versionB.prerelease.length); i++) {
+    const identifierA = versionA.prerelease[i];
+    const identifierB = versionB.prerelease[i];
+
+    // Shorter pre-release is lower
+    if (identifierA === undefined) {
+      return -1;
+    }
+    if (identifierB === undefined) {
+      return 1;
+    }
+
+    const numA = Number.isInteger(identifierA) ? identifierA : null;
+    const numB = Number.isInteger(identifierB) ? identifierB : null;
+
+    // Both numeric: compare numerically
+    if (numA !== null && numB !== null) {
+      if (numA !== numB) {
+        return numA < numB ? -1 : 1;
+      }
+    }
+    // One numeric, one alphanumeric: numeric is lower
+    else if (numA !== null) {
+      return -1;
+    } else if (numB !== null) {
+      return 1;
+    }
+    // Both alphanumeric: compare in ASCII order
