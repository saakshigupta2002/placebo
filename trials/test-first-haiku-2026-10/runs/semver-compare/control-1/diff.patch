+
+function parseVersion(versionStr) {
+  if (typeof versionStr !== "string") {
+    throw new TypeError(`Invalid version: ${versionStr}`);
+  }
+
+  // Remove leading 'v' if present
+  let version = versionStr.startsWith("v") ? versionStr.slice(1) : versionStr;
+
+  // Split off build metadata (after +)
+  const [versionPart] = version.split("+");
+  version = versionPart;
+
+  // Split version and pre-release
+  const [baseVersion, prereleasePart] = version.split("-");
+
+  // Parse major.minor.patch
+  const parts = baseVersion.split(".");
+  if (parts.length !== 3) {
+    throw new TypeError(`Invalid version: ${versionStr}`);
+  }
+
+  const major = parseInt(parts[0], 10);
+  const minor = parseInt(parts[1], 10);
+  const patch = parseInt(parts[2], 10);
+
+  if (!Number.isFinite(major) || !Number.isFinite(minor) || !Number.isFinite(patch)) {
+    throw new TypeError(`Invalid version: ${versionStr}`);
+  }
+
+  if (major < 0 || minor < 0 || patch < 0) {
+    throw new TypeError(`Invalid version: ${versionStr}`);
+  }
+
