{
  "name": "placebo-cli",
  "version": "0.1.0",
  "description": "Clinical trials for AI agent skills. Find out if a skill, prompt, model or agent actually helps on your codebase before you trust it.",
  "type": "module",
  "bin": {
    "placebo": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:prose": "node scripts/check-prose.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:prose",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "evals",
    "claude-code",
    "codex",
    "mcp",
    "benchmark",
    "a-b-testing",
    "llm",
    "developer-tools",
    "cli",
    "agent-security"
  ],
  "author": "Saakshi Gupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saakshigupta2002/placebo.git"
  },
  "homepage": "https://github.com/saakshigupta2002/placebo#readme",
  "bugs": {
    "url": "https://github.com/saakshigupta2002/placebo/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
